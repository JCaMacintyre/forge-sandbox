# ============================================================
# Lead Reply Automation — Config Reference
#
# These are NOT environment variables — Google Apps Script
# doesn't use .env files. This is a reference for the CONFIG
# block at the top of Code.gs.
#
# Copy these fields into the CONFIG object in Code.gs and
# fill in the right values for each client.
# ============================================================

BUSINESS_NAME=Acme Services
BUSINESS_PHONE=(555) 123-4567
BUSINESS_HOURS=Mon–Fri 9am–5pm
BOOKING_LINK=https://calendly.com/your-link      # leave blank to omit from templates

OWNER_EMAIL=owner@example.com                    # receives an alert for every new lead

GMAIL_LABEL=Leads                                # Gmail label applied to incoming leads
REPLIED_LABEL=Replied                            # label applied after auto-reply is sent
SHEET_NAME=Lead Log                              # Google Sheet tab name

REPLY_SUBJECT_PREFIX=Re:                         # prefix for reply subject line
DEFAULT_TEMPLATE=general                         # general | booking | quote

TEST_MODE=false                                  # true = log only, no emails sent
